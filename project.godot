;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Magooster1000s Purple"
run/main_scene="uid://0xklxw3hgltm"
config/custom_user_dir_name="magooster1000's purple"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.101961, 0.0823529, 0.145098, 1)
boot_splash/stretch_mode=3
boot_splash/image="uid://bqhy6lf0krms2"
config/icon="uid://2qqerm1okbdh"
boot_splash/minimum_display_time=8
config/locale="es"

[audio]

buses/default_bus_layout="uid://txt37cindtxy"
driver/enable_input=true

[autoload]

