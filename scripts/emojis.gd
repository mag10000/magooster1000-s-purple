func parser(_args):
	var categories = []
	var final_dict = {}
	for folder in DirAccess.get_directories_at("res://art/icons8 emoji icons/"):
		categories.append(folder)
		for file in DirAccess.get_files_at('res://art/icons8 emoji icons/' + folder):
			if not file.contains(".import"):
				if not final_dict.has(file.get_basename().replace(".png","")):
					final_dict[file.get_basename().replace(".png","")] = {"category" : folder, "path" : 'res://art/icons8 emoji icons/' + folder + "/" + file}
				else:
					final_dict[file.get_basename().replace(".png","") + "_multia"] = {"category" : folder, "path" : 'res://art/icons8 emoji icons/' + folder + "/" + file}


	var file = FileAccess.open("user://parser.txt", FileAccess.WRITE)
	file.store_string("emojis: 
" + str(final_dict) + "


categories:
" + str(categories))
	file.close()
	file = null
	Console.print("file with dict and array at [url=" + OS.get_user_data_dir() + "/parser.txt" + "]user://parser.txt[/url]")
